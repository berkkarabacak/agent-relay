# Required: Claude Console API key. Never expose this to browser code.
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: reuse an existing cloud or self-hosted environment.
# ANTHROPIC_ENVIRONMENT_ID=env_...

# Optional defaults.
ANTHROPIC_MODEL=claude-opus-5-5
SESSION_BUDGET_CENTS=1000
PORT=7100
API_PORT=8787
HOST=127.0.0.1

# Recommended for any shared/network deployment. Use a long random value.
# Browser: any username + this token as the password. API clients: Bearer token.
# AGENT_RELAY_ACCESS_TOKEN=replace-with-a-long-random-token

# Self-hosted worker only (run worker/index.mjs inside Linux/WSL, not Windows).
# ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-...
# AGENT_WORKDIR=/mnt/c/path/to/game
